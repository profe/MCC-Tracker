<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="850.0"
            style="-fx-background-color: white; -fx-border-color: #444444; -fx-border-width: 1;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.miracosta.cs112.controllers.WorkoutController">

    <top>
        <VBox alignment="CENTER_LEFT" spacing="15.0">
            <padding>
                <Insets top="15.0" right="1.0" bottom="1.0" left="10.0" />
            </padding>
            <children>
                <Button text="← Back"
                        onAction="#goBackToMainMenu"
                        prefHeight="40.0"
                        prefWidth="120.0"
                        style="-fx-background-color: #444444; -fx-text-fill: white; -fx-font-size: 18; -fx-background-radius: 8;" />
                <Label fx:id="titleLabel"
                       text="Lose Weight/Stay Active/Build Muscle"
                       textFill="#444444"
                       wrapText="true"
                       textAlignment="CENTER">
                    <font>
                        <Font size="30.0" />
                    </font>
                </Label>
                <Separator prefWidth="200.0" />
            </children>
        </VBox>
    </top>

    <center>
        <HBox alignment="CENTER" spacing="20.0">
            <padding>
                <Insets top="25.0" right="30.0" bottom="25.0" left="30.0" />
            </padding>
            <children>

                <VBox alignment="CENTER" spacing="15.0" HBox.hgrow="ALWAYS">
                    <children>
                        <ImageView fx:id="image1"
                                   fitHeight="160.0"
                                   fitWidth="240.0"
                                   preserveRatio="true" />
                        <Label fx:id="workout1Label"
                               text="Workout Name #1"
                               textFill="#444444"
                               wrapText="true"
                               textAlignment="CENTER">
                            <font>
                                <Font size="26.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <VBox alignment="CENTER" spacing="15.0" HBox.hgrow="ALWAYS">
                    <children>
                        <ImageView fx:id="image2"
                                   fitHeight="160.0"
                                   fitWidth="240.0"
                                   preserveRatio="true" />
                        <Label fx:id="workout2Label"
                               text="Workout Name #2"
                               textFill="#444444"
                               wrapText="true"
                               textAlignment="CENTER">
                            <font>
                                <Font size="26.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <VBox alignment="CENTER" spacing="15.0" HBox.hgrow="ALWAYS">
                    <children>
                        <ImageView fx:id="image3"
                                   fitHeight="160.0"
                                   fitWidth="240.0"
                                   preserveRatio="true" />
                        <Label fx:id="workout3Label"
                               text="Workout Name #3"
                               textFill="#444444"
                               wrapText="true"
                               textAlignment="CENTER">
                            <font>
                                <Font size="26.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

            </children>
        </HBox>
    </center>
    <HBox alignment="CENTER" spacing="30.0">

        <children>

            <!-- Progress Section -->
            <VBox alignment="CENTER" spacing="8.0">
                <children>
                    <Label text="Weekly Progress"
                           style="-fx-font-size: 20; -fx-font-weight: bold;" />

                    <ProgressBar fx:id="progressBar"
                                 prefWidth="220.0"
                                 progress="0.75" />

                    <Label fx:id="progressLabel"
                           text="75% Complete"
                           style="-fx-font-size: 16;" />
                </children>
            </VBox>

            <!-- BMI Section -->
            <VBox alignment="CENTER" spacing="8.0">
                <children>
                    <Label text="BMI Result"
                           style="-fx-font-size: 20; -fx-font-weight: bold;" />

                    <Label fx:id="bmiLabel"
                           text="Normal BMI"
                           style="-fx-font-size: 18;" />
                </children>
            </VBox>

            <!-- Workout History -->
            <VBox alignment="CENTER" spacing="8.0">
                <children>
                    <Label text="Workout History"
                           style="-fx-font-size: 20; -fx-font-weight: bold;" />

                    <ListView fx:id="historyListView"
                              prefHeight="120.0"
                              prefWidth="220.0" />
                </children>
            </VBox>

        </children>

    </HBox>

    <bottom>
        <VBox spacing="10.0">
            <padding>
                <Insets top="10.0" right="30.0" bottom="25.0" left="30.0" />
            </padding>
            <children>
                <TextArea fx:id="tipArea"
                          editable="false"
                          prefHeight="100.0"
                          maxWidth="Infinity"
                          style="-fx-font-size: 24; -fx-border-color: #444444; -fx-border-width: 1;"
                          text="Workout Tips for Lose Weight/Stay Active/Build Muscle"
                          wrapText="true" />
            </children>
        </VBox>
    </bottom>

</BorderPane>